# Optional — Cloudflare R2 media storage
# Find Account ID: Cloudflare Dashboard → R2 → Overview (right sidebar)
# Create R2 API token: R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
# Public URL: bucket Settings → Public access → Enable → copy R2.dev subdomain or custom domain
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name (not a folder path)
R2_BUCKET_NAME=product-media
R2_PUBLIC_URL=
