# Local development (npm run dev)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ecommerce
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
PORT=5000

# Optional — Razorpay payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional — Cloudflare R2 media storage
# Find Account ID: Cloudflare Dashboard → R2 → Overview (right sidebar)
# Create R2 API token: R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
# Public URL: bucket Settings → Public access → Enable → copy R2.dev subdomain or custom domain
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=product-media
R2_PUBLIC_URL=

# Cloudflare Workers (npm run dev:worker / npm run deploy)
# DATABASE_URL is provided by Hyperdrive — do not set it as a Worker secret.
# Set these via wrangler.jsonc [vars] or `wrangler secret put`:
#   JWT_SECRET, RAZORPAY_KEY_SECRET, R2_SECRET_ACCESS_KEY
# Set CORS_ORIGIN in wrangler.jsonc to your frontend Workers URL.
